{
  "name": "fresh-chicken-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/ensure-db.cjs && npx next dev -p 3000 -H 0.0.0.0",
    "build": "npx prisma generate && node scripts/ensure-db.cjs && npx next build",
    "start": "node scripts/ensure-db.cjs && npx next start -p 3000 -H 0.0.0.0",
    "lint": "npx next lint",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "prisma:generate": "npx prisma generate",
    "prisma:push": "npx prisma db push",
    "prisma:seed": "node prisma/seed.cjs"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.16.0",
    "next": "^15.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "prisma": "^6.4.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2"
  }
}
